# Exclude the optional Node-based db_visualizer tool from the PostgreSQL DB image.
# This prevents any accidental npm install/npm start/node server.js during build or startup.
db_visualizer/
**/db_visualizer/**

# Exclude common Node artifacts if any appear in this folder tree
**/node_modules/**
npm-debug.log*
yarn-error.log*
pnpm-debug.log*
